{
  "name": "harness-creator",
  "version": "2.0.0",
  "description": "Requirement-linked harness engineering for AI coding agents — project models, capability-derived features, traceability, evidence gates, and reliable execution across sessions.",
  "license": "MIT",
  "author": "Learn Harness Engineering",
  "repository": "https://github.com/walkinglabs/learn-harness-engineering",
  "languages": ["en", "zh"],
  "compatibility": {
    "minCliVersion": "0.1.0",
    "agents": [
      "claude-code",
      "codex-cli",
      "cursor",
      "windsurf",
      "generic"
    ]
  },
  "entryPoint": "SKILL.md",
  "references": [
    "references/project-model-pattern.md",
    "references/memory-persistence-pattern.md",
    "references/context-engineering-pattern.md",
    "references/skill-runtime-pattern.md",
    "references/tool-registry-pattern.md",
    "references/multi-agent-pattern.md",
    "references/lifecycle-bootstrap-pattern.md",
    "references/gotchas.md"
  ],
  "triggers": [
    "harness engineering",
    "agent reliability",
    "session continuity",
    "memory persistence",
    "verification workflow",
    "project model",
    "requirements traceability",
    "acceptance criteria",
    "scope control",
    "lifecycle management",
    "AGENTS.md",
    "CLAUDE.md",
    "feature tracking",
    "session handoff",
    "multi-agent coordination",
    "context engineering",
    "tool safety",
    "permission pipeline"
  ],
  "bundled": {
    "scripts": [
      "scripts/create-harness.mjs",
      "scripts/discover-project.mjs",
      "scripts/validate-harness.mjs",
      "scripts/render-assessment-html.mjs",
      "scripts/run-benchmark.mjs",
      "scripts/lib/harness-utils.mjs",
      "scripts/runtime/project-contract.mjs",
      "scripts/runtime/validate-project-contract.mjs"
    ],
    "assets": [],
    "templates": [
      "templates/agents.md",
      "templates/project-model.schema.json",
      "templates/feature-list.schema.json",
      "templates/init.sh",
      "templates/progress.md",
      "templates/session-handoff.md"
    ]
  }
}
